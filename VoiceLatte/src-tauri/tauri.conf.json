{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceLatte",
  "version": "0.1.0",
  "identifier": "com.hibachi.voicelatte.tauri",
  "build": {
    "beforeDevCommand": "npm run native:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run native:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 760,
        "height": 520,
        "minWidth": 680,
        "minHeight": 440,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "hud",
        "url": "index.html?hud=1",
        "title": "",
        "width": 720,
        "height": 116,
        "backgroundColor": "#00000000",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/voicelatte-speech"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "Developer ID Application: HIBACHI inc. (TYX92DB6TA)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
