{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceLatte",
  "version": "0.4.3",
  "identifier": "com.hibachi.voicelatte",
  "build": {
    "beforeDevCommand": "npm run native:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run native:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 760,
        "height": 520,
        "minWidth": 680,
        "minHeight": 440,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "hud",
        "url": "index.html?hud=1",
        "title": "",
        "width": 616,
        "height": 80,
        "backgroundColor": "#00000000",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/voicelatte-speech"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "bundleVersion": "14",
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Developer ID Application: HIBACHI inc. (TYX92DB6TA)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/hibachi-inc/voicelatte-releases/main/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNkQzRTMzMjdGNzg3Q0EKUldUS2gvY25NejV0ck5Hd3Mzd2JlZ3RiZXJ2bWdmRE5pVGxIellwK0RLeGNBMzNIMWZoYzA5MXgK",
      "windows": { "installMode": "passive" }
    }
  }
}
